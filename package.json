{
    "name":  "trektribe",
    "version":  "0.1.0",
    "private":  true,
    "workspaces":  [
                       "apps/*",
                       "packages/*"
                   ],
    "scripts":  {
                    "start":  "npm run start -w @trektribe/mobile",
                    "web":  "npm run web -w @trektribe/mobile",
                    "api":  "npm run dev -w @trektribe/api",
                    "typecheck":  "tsc --noEmit -p apps/mobile \u0026\u0026 tsc --noEmit -p apps/api",
                    "test":  "node --import tsx --test --test-concurrency=4 tests/*.test.ts",
                    "test:db":  "node --import tsx --test tests/integration/*.test.ts",
                    "build:api":  "tsc -p apps/api",
                    "build:web":  "npm run build:web -w @trektribe/mobile",
                    "db:migrate":  "node --import tsx scripts/migrate.ts",
                    "api:generate":  "node scripts/generate-api.mjs",
                    "api:check":  "node scripts/generate-api.mjs --check"
                },
    "devDependencies":  {
                            "@types/node":  "^22.0.0",
                            "@types/pg":  "^8.15.0",
                            "openapi-typescript":  "^7.13.0",
                            "tsx":  "^4.20.0",
                            "typescript":  "~5.9.2"
                        },
    "engines":  {
                    "node":  "\u003e=22.13"
                }
}
