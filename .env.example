# Export backend variables into your shell; .env is not loaded automatically.
DEMO_MODE=true
HOST=127.0.0.1
PORT=3001
# Optional: otherwise API uses a single-process atomic JSON store.
# DATABASE_URL=postgres://trektribe:local-development-only@localhost:5432/trektribe
# Optional mobile connection; set in apps/mobile/.env.local or export before Expo.
# EXPO_PUBLIC_API_URL=http://localhost:3001

# Optional OIDC development mode; requires PostgreSQL and DEMO_MODE=false.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://your-provider.example/
# OIDC_AUDIENCE=trektribe-api
# OIDC_JWKS_URL=https://your-provider.example/keys
# See docs/AUTHENTICATION.md for public client settings and callbacks.
