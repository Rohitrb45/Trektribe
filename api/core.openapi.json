  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Profile": {
        "type": "object",
        "required": [
          "id",
          "name",
          "initials",
          "username",
          "bio",
          "level",
          "completed",
          "distanceKm",
          "gear",
          "badges"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "initials": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "completed": {
            "type": "number"
          },
          "distanceKm": {
            "type": "number"
          },
          "gear": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "badges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Coordinate": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "Trek": {
        "type": "object",
        "required": [
          "id",
          "title",
          "region",
          "description",
          "difficulty",
          "distanceKm",
          "elevationM",
          "duration",
          "altitudeM",
          "rating",
          "reports",
          "coordinates",
          "route",
          "highlights",
          "color"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "Easy",
              "Moderate",
              "Hard"
            ]
          },
          "distanceKm": {
            "type": "number"
          },
          "elevationM": {
            "type": "number"
          },
          "duration": {
            "type": "string"
          },
          "altitudeM": {
            "type": "number"
          },
          "rating": {
            "type": "number"
          },
          "reports": {
            "type": "number"
          },
          "coordinates": {
            "$ref": "#/components/schemas/Coordinate"
          },
          "route": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Coordinate"
            }
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "color": {
            "type": "string"
          },
          "routeVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "ownerId": {
            "type": "string",
            "format": "uuid"
          },
          "hasElevation": {
            "type": "boolean"
          }
        }
      },
      "Post": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "author",
          "initials",
          "trekId",
          "content",
          "rating",
          "condition",
          "observedAt",
          "createdAt",
          "likedBy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "author": {
            "type": "string"
          },
          "initials": {
            "type": "string"
          },
          "trekId": {
            "type": "string",
            "format": "uuid"
          },
          "content": {
            "type": "string"
          },
          "rating": {
            "type": "number"
          },
          "condition": {
            "type": "string"
          },
          "observedAt": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "likedBy": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "Comment": {
        "type": "object",
        "required": [
          "id",
          "postId",
          "userId",
          "author",
          "body",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "postId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "author": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        }
      },
      "Member": {
        "type": "object",
        "required": [
          "userId",
          "status"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "pending"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "member",
              "cohost"
            ]
          }
        }
      },
      "Trip": {
        "type": "object",
        "required": [
          "id",
          "trekId",
          "title",
          "organizerId",
          "organizer",
          "startsAt",
          "maxParticipants",
          "members",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "trekId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "organizerId": {
            "type": "string",
            "format": "uuid"
          },
          "organizer": {
            "type": "string"
          },
